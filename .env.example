# Template only. Real credentials belong in .env (ignored by Git) or environment variables.
ASSISTANT_LLM_MODE=demo
ASSISTANT_API_KEY=
ASSISTANT_API_BASE=https://api.moonshot.cn/v1
ASSISTANT_MODEL=kimi-k2.6
# For Kimi models supporting non-thinking mode; consult provider docs before changing models.
ASSISTANT_LLM_EXTRA_BODY='{"thinking":{"type":"disabled"}}'
ASSISTANT_TIMEOUT=60
ASSISTANT_MAX_TOKENS=4096
ASSISTANT_DAILY_CALLS=30
ASSISTANT_TIMEZONE=Asia/Shanghai
ASSISTANT_DATA_DIR=data
# Browser tasks: shared daily limit still applies; system DNS refuses private/Fake-IP addresses.
ASSISTANT_BROWSER_CALLS=40
ASSISTANT_BROWSER_SECONDS=900
ASSISTANT_BROWSER_STEPS=120
# Opt in only after checking the selected model's image/tool compatibility.
ASSISTANT_BROWSER_VISION=false
# System DNS only. Legacy google values are accepted but also use system DNS.
ASSISTANT_BROWSER_DNS=system
# v0.3: new QQ authorization code only in ignored .env; never use your QQ password.
QQ_IMAP_USER=
QQ_IMAP_AUTH_CODE=
# Required before private mail is enabled. Generate locally: python -c 'import secrets; print(secrets.token_urlsafe(32))'
ASSISTANT_ACCESS_TOKEN=
ASSISTANT_MAIL_POLL_SECONDS=60
# Optional comma-separated identities used by YOU in forwarded chat; empty means unknown.
ASSISTANT_CHAT_SELF_NAMES=
