# Template only. Real credentials belong in .env (ignored by Git) or environment variables.
ASSISTANT_LLM_MODE=demo
ASSISTANT_API_KEY=
ASSISTANT_API_BASE=https://api.moonshot.cn/v1
ASSISTANT_MODEL=kimi-k2.6
# For Kimi models supporting non-thinking mode; consult provider docs before changing models.
ASSISTANT_LLM_EXTRA_BODY='{"thinking":{"type":"disabled"}}'
ASSISTANT_TIMEOUT=60
ASSISTANT_MAX_TOKENS=4096
ASSISTANT_DAILY_CALLS=30
ASSISTANT_TIMEZONE=Asia/Shanghai
ASSISTANT_DATA_DIR=data
